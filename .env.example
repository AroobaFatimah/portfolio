# Portfolio Environment Variables
# Copy this file to .env.local and update values

# These are optional - can be configured in config/profile.ts instead
# NEXT_PUBLIC_PROFILE_NAME=Arooba Fatima
# NEXT_PUBLIC_PROFILE_EMAIL=your-email@example.com
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username

# Deployment
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
